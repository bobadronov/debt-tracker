## Copy this file to secrets.properties (same directory) and fill in real values.
# secrets.properties is git-ignored; this template is the only version tracked in VCS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Web OAuth 2.0 client ID (Google Cloud Console → Clients → Web application).
# Used as the serverClientId for Android's native "Sign in with Google". Public value.
GOOGLE_SERVER_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
