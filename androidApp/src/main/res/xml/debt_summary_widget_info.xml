<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size RemoteViews widget (DebtSummaryWidgetReceiver). resizeMode="none" + one declared
     size; the layout is designed for exactly minWidth x minHeight. initialLayout and previewLayout
     both point at the real layout now (unlike the old Glance setup, which had no layout resource
     and needed stand-in mocks) — the launcher shows it with the placeholder strings baked into
     widget_debt_summary.xml until the first onUpdate fills in real values.
     targetCellWidth/Height + previewLayout are API 31+ only; the xml-v31/ copy is what those
     devices read — keep both in sync. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_debt_summary"
    android:previewLayout="@layout/widget_debt_summary"
    android:resizeMode="none"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
