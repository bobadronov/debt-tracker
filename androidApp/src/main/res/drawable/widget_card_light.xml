<?xml version="1.0" encoding="utf-8"?>
<!-- Widget card background, light. Solid #F3F3F4 = SurfaceContainerLowLight (sharedUI
     theme/Color.kt), matching DebtSummaryWidgetReceiver's LabelLight/accent palette. The
     widget picks this or widget_card_dark at runtime from the app's theme preference (not the
     launcher's uiMode), so it is NOT a -night resource. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFF3F3F4" />
    <corners android:radius="24dp" />
</shape>
