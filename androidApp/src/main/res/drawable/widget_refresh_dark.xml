<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width "refresh" bar background, dark. One step lighter than widget_card_dark
     (#1A1C1C). Runtime-selected sibling of widget_refresh_light — see that file. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF262A29" />
    <!-- Square top (meets the card above), rounded bottom (widget's outer edge). -->
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="16dp" />
</shape>
