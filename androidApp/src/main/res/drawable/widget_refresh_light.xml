<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width "refresh" bar background, light. One step deeper than widget_card_light
     (#F3F3F4) so the bar reads as a distinct strip. Runtime-selected sibling of
     widget_refresh_dark by DebtSummaryWidgetReceiver — NOT a -night resource. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFE7E7EA" />
    <!-- Square top (meets the card above), rounded bottom (widget's outer edge). -->
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="16dp" />
</shape>
