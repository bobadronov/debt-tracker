<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ copy of xml/debt_summary_widget_info.xml — keep both in sync. Fixed-size RemoteViews
     widget (DebtSummaryWidgetReceiver); the layout is designed for exactly minWidth x minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_debt_summary"
    android:previewLayout="@layout/widget_debt_summary"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
