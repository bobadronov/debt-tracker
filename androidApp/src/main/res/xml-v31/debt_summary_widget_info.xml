<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size widget: resizeMode="none" and a single declared size. WidgetUi reads this
     size verbatim (SizeMode.Single) and renders one layout, so minWidth/minHeight are the
     real design dimensions, not just a lower bound. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="130dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_preview"
    android:resizeMode="none"
    android:widgetCategory="home_screen" />
