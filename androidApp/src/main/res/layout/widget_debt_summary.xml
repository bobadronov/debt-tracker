<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget (RemoteViews) — DebtSummaryWidgetReceiver fills every value at runtime:
  card + refresh-bar backgrounds, the two accent colours, the tinted icon circles, the amounts,
  the refresh label and every click target. Colours are driven by the app's own light/dark
  preference (AppSettings.theme), NOT the launcher's uiMode, so nothing here is a -night resource
  and every colour below is a placeholder overwritten on update.

  One fluid layout for the whole resize range (2x2 .. 4x2, see debt_summary_widget_info.xml):
  the two totals stack in a weighted column that shrinks with the widget, the refresh control is
  a full-width bar pinned to the bottom.

  tools:* values only affect the layout editor / the system widget picker preview.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_light"
    android:padding="12dp"
    tools:layout_width="160dp"
    tools:layout_height="160dp"
    tools:ignore="HardcodedText,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_row_debtors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/widget_badge_debtors"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_badge_circle" />

                <ImageView
                    android:id="@+id/widget_icon_debtors"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_trend_down" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_debtors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Owed to me"
                    android:textColor="#404941"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_amount_debtors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="0 ₴"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_creditors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">

                <ImageView
                    android:id="@+id/widget_badge_creditors"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_badge_circle" />

                <ImageView
                    android:id="@+id/widget_icon_creditors"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_trend_up" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_creditors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="I owe"
                    android:textColor="#404941"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_amount_creditors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="0 ₴"
                    android:textColor="#BB152C"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/widget_refresh_light"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:id="@+id/widget_refresh_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_refresh" />

        <TextView
            android:id="@+id/widget_refresh_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Refresh"
            android:textColor="#404941"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
