<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget (RemoteViews) — DebtSummaryWidgetReceiver fills every value at runtime:
  card background, the two accent colours, the tinted icon circles, the amounts, and the
  click targets. Colours are driven by the app's own light/dark preference (AppSettings.theme),
  NOT the launcher's uiMode, so nothing here is a -night resource and every colour below is a
  placeholder overwritten on update. Fixed size (see debt_summary_widget_info.xml).

  tools:* values only affect the layout editor / the system widget picker preview.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_light"
    android:padding="14dp"
    tools:layout_width="250dp"
    tools:layout_height="130dp"
    tools:ignore="HardcodedText,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/widget_row_debtors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/widget_badge_debtors"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_badge_circle" />

                <ImageView
                    android:id="@+id/widget_icon_debtors"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_trend_down" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_debtors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Owed to me"
                    android:textColor="#404941"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_amount_debtors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="0 ₴"
                    android:textColor="#2E7D32"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_creditors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/widget_badge_creditors"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_badge_circle" />

                <ImageView
                    android:id="@+id/widget_icon_creditors"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_trend_up" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_label_creditors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="I owe"
                    android:textColor="#404941"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_amount_creditors"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="0 ₴"
                    android:textColor="#BB152C"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_refresh"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:padding="7dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_refresh" />
</FrameLayout>
